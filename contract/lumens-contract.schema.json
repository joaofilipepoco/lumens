{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumens Semantic Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "operations", "attributes", "events", "metric_dimensions", "baggage"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "namespace"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "namespace": {"type": "string", "minLength": 1}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/operation"}
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/attribute"}
    },
    "events": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/event"}
    },
    "metric_dimensions": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/metricDimension"}
    },
    "baggage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/baggage"}
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["owner", "description"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "stability": {"enum": ["experimental", "stable", "deprecated"]},
        "deprecated": {"type": "boolean"}
      }
    },
    "operation": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "description", "outcomes"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "stability": {"enum": ["experimental", "stable", "deprecated"]},
            "deprecated": {"type": "boolean"}
          }
        }
      ]
    },
    "attribute": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "description", "type", "privacy", "cardinality"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "type": {"enum": ["string", "boolean", "integer", "double"]},
            "privacy": {"enum": ["public", "internal", "pseudonymous", "personal", "secret"]},
            "cardinality": {"enum": ["bounded", "high"]},
            "allowed_values": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "metric_dimension": {"type": "boolean"},
            "stability": {"enum": ["experimental", "stable", "deprecated"]},
            "deprecated": {"type": "boolean"}
          }
        }
      ]
    },
    "event": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "description", "delivery"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "delivery": {"enum": ["log"]},
            "required_attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "optional_attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "stability": {"enum": ["experimental", "stable", "deprecated"]},
            "deprecated": {"type": "boolean"}
          }
        }
      ]
    },
    "metricDimension": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "description", "attribute"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "attribute": {"type": "string", "minLength": 1},
            "stability": {"enum": ["experimental", "stable", "deprecated"]},
            "deprecated": {"type": "boolean"}
          }
        }
      ]
    },
    "baggage": {
      "allOf": [
        {"$ref": "#/$defs/metadata"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "description", "privacy"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "privacy": {"enum": ["public", "internal", "pseudonymous"]},
            "stability": {"enum": ["experimental", "stable", "deprecated"]},
            "deprecated": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
