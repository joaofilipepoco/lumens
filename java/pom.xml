<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.deloitte.lumens</groupId>
  <artifactId>lumens-parent</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>lumens-observability-api</module>
    <module>lumens-observability-spring-boot-autoconfigure</module>
    <module>lumens-observability-spring-boot-starter</module>
    <module>lumens-observability-spring-boot-runtime</module>
    <module>lumens-observability-test</module>
    <module>lumens-observability-bom</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.antrun-plugin.version>3.1.0</maven.antrun-plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven.antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>mvp-f01-placeholder</id>
            <phase>validate</phase>
            <configuration>
              <target>
                <fail message="Java implementation is deferred to MVP-F03. MVP-F01 created only the repository foundation." />
              </target>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
